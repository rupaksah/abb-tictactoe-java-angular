<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.tictactoe</groupId>
    <artifactId>backend</artifactId>
    <version>0.1.0</version>
    <name>backend</name>
    <description>Tic Tac Toe REST API backend (Java / Spring Boot)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (jakarta.validation.constraints on the DTOs,
             enforced via @Valid on controller method parameters). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- OpenAPI/Swagger: auto-generates /v3/api-docs and an interactive
             UI at /swagger-ui.html from the @RestController/@Tag/@Operation
             annotations already on the controllers - no hand-written spec. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SQLite persistence for games and the scoreboard across restarts
             (the problem statement explicitly allows this as an alternative
             to in-memory storage). Plain JdbcTemplate, not JPA/Hibernate, to
             avoid depending on a Hibernate SQLite dialect. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>

        <!-- Flyway: versioned SQL migrations (src/main/resources/db/migration)
             replacing the schema.sql/spring.sql.init.mode approach from the
             previous round - the migration history is now tracked in a
             flyway_schema_history table instead of re-running an idempotent
             script on every startup. flyway-database-sqlite is Flyway's
             dedicated SQLite integration, required alongside flyway-core
             since Flyway 9/10 split per-database support into separate
             modules; baseline-on-migrate (application.yml) lets it adopt the
             tictactoe.db created by the pre-Flyway schema.sql approach
             without failing on a "non-empty schema" error. -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
            </dependency>

        <!-- Lombok: generates the DTOs' getters/setters/constructors and
             GameService's logger field at compile time. Deliberately scoped
             to the DTO and service/controller layers, NOT the framework-free
             core/model packages (Board, GameSession, Scoreboard, Move, the
             enums) - those are intentionally kept compilable with plain
             javac/java (see README/AI Tools point 1), which Lombok's
             annotation-processor-based code generation would break. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
